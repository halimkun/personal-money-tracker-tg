# ===== Bot =====
# Token bot dari @BotFather
BOT_TOKEN=

# polling | webhook (PRD §12)
BOT_MODE=polling

# ID admin (pemilik bot), dipisah koma. Contoh: 123456789,987654321
ADMIN_IDS=

# ===== Kredensial PostgreSQL (hanya dipakai docker compose) =====
# Default otomatis: moneybot / moneybot / moneybot.
# Ganti di sini kalau perlu — dipakai service postgres DAN URL koneksi bot
# sekaligus (satu sumber, selalu sinkron). Contoh:
# POSTGRES_USER=moneybot
# POSTGRES_PASSWORD=rahasia
# POSTGRES_DB=moneybot

# ===== Database =====
# Bot di host + DB dari docker compose (localhost), atau PostgreSQL manual:
DATABASE_URL=postgresql+asyncpg://moneybot:moneybot@localhost:5432/moneybot
# SQLite (dev tanpa Postgres):
# DATABASE_URL=sqlite+aiosqlite:///bot.db
# Kalau full Docker (bot juga di container): TIDAK perlu diisi — docker-compose.yml
# override otomatis dengan hostname service di dalam jaringan compose:
#   postgresql+asyncpg://moneybot:moneybot@postgres:5432/moneybot
#   redis://redis:6379/0

# ===== FSM storage =====
# Opsional: Redis agar state FSM bertahan saat bot restart (PRD §8).
# Kalau kosong → MemoryStorage (cukup untuk dev).
# REDIS_URL=redis://localhost:6379/0

# ===== Webhook (hanya jika BOT_MODE=webhook) =====
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET_TOKEN=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ===== Keamanan =====
# Kunci Fernet untuk enkripsi AI API key di DB. Generate dengan:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kalau kosong, API key disimpan plaintext (hanya untuk dev).
ENCRYPTION_KEY=

# ===== Default (bisa diubah admin lewat /admin) =====
# Zona waktu untuk tanggal transaksi & scheduler
TIMEZONE=Asia/Jakarta
# Batas transaksi gratis per bulan (freemium)
FREE_TRANSACTION_LIMIT=200
# Batas panggilan AI quick-add per user per hari
AI_DAILY_LIMIT=30
# Menit sebelum draft quick-add kadaluarsa otomatis
QUICK_ADD_DRAFT_TTL_MINUTES=15
# Menit masa berlaku callback token
CALLBACK_REF_TTL_MINUTES=15
